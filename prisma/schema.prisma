generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity"]
}

/// Roles del taller: Administrador, Asesor de Servicio, Técnico Mecánico
model Rol {
  id          Int      @id @default(autoincrement()) @map("id_rol")
  nombre      String   @unique @db.VarChar(100)
  descripcion String?  @db.VarChar(255)
  usuarios    Usuario[]

  @@map("roles")
  @@schema("identity")
}

/// Usuarios del taller. El acceso se resuelve por rol.
model Usuario {
  id            Int       @id @default(autoincrement()) @map("id_usuario")
  nombre        String    @db.VarChar(100)
  apellido      String    @db.VarChar(100)
  correo        String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  rolId         Int       @map("id_rol")
  rol           Rol       @relation(fields: [rolId], references: [id])
  activo        Boolean   @default(true)
  ultimoAcceso  DateTime? @map("ultimo_acceso") @db.Timestamptz(6)
  fechaCreacion DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  @@index([rolId])
  @@map("usuarios")
  @@schema("identity")
}
